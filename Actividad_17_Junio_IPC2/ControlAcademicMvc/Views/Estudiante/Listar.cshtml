@model IReadOnlyCollection<Estudiante>

<section class="workspace">
    <div class="section-header">
        <div>
            <p class="eyebrow">Control académico</p>
            <h1>Estudiantes registrados</h1>
        </div>
    </div>

    <div class="grid">
        <section class="panel">
            <h2>Listado</h2>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Carné</th>
                            <th>Nombre</th>
                            <th>Promedio</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var estudiante in Model)
                    {
                        <tr>
                            <td>@estudiante.Carne</td>
                            <td>@estudiante.Nombre</td>
                            <td>@estudiante.Promedio.ToString("0.00")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel">
            <h2>Registrar</h2>
            <form id="registroForm" class="form">
                <label>
                    Carné
                    <input name="carne" type="number" min="1" required />
                </label>
                <label>
                    Nombre
                    <input name="nombre" type="text" required />
                </label>
                <label>
                    Promedio
                    <input name="promedio" type="number" min="0" max="100" step="0.01" required />
                </label>
                <button type="submit">Registrar estudiante</button>
                <p id="mensaje" class="message" aria-live="polite"></p>
            </form>
        </section>
    </div>
</section>

@section Scripts {
    <script>
        const form = document.querySelector("#registroForm");
        const mensaje = document.querySelector("#mensaje");

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            const data = new FormData(form);
            const estudiante = {
                carne: Number(data.get("carne")),
                nombre: String(data.get("nombre")),
                promedio: Number(data.get("promedio"))
            };

            const response = await fetch('@Url.Action("Registrar", "Estudiante")', {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(estudiante)
            });

            if (response.ok) {
                window.location.reload();
                return;
            }

            const error = await response.json();
            mensaje.textContent = error.mensaje ?? "No se pudo registrar.";
        });
    </script>
}
